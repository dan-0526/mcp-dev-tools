# ========================================
# 复制此文件为 .env 并填入你的真实 token
# cp .env.example .env
# ========================================

# GitHub Personal Access Token
# 获取方式: GitHub → Settings → Developer settings → Personal access tokens → Tokens (classic)
# 勾选 repo 权限即可
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# GitLab Personal Access Token
# 获取方式: GitLab → Preferences → Access Tokens → 创建 token
# 勾选 read_repository 权限
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

# GitLab 实例地址 (如果是自建 GitLab，改成你的地址)
GITLAB_URL=https://gitlab.com

# Figma Personal Access Token
# 获取方式: Figma → 左上角头像 → Settings → Personal access tokens → Generate new token
FIGMA_TOKEN=figd_xxxxxxxxxxxxxxxxxxxx

# ========================================
# Vision / Image Recognition (可选)
# ========================================

# 识别引擎: "claude" | "openai" | 留空使用 macOS 本地 OCR (免费，无需 key)
VISION_PROVIDER=

# Claude API Key (VISION_PROVIDER=claude 时需要)
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# OpenAI API Key (VISION_PROVIDER=openai 时需要)
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx

# 可选: 覆盖默认模型 (Claude 默认 claude-sonnet-4-20250514, OpenAI 默认 gpt-4o)
# VISION_MODEL=

# ========================================
# Claude relay (可选)
# ========================================

# 当 MCP 客户端所在环境不能直接访问 Claude CLI / 本机代理时，
# 可以单独启动一个 relay server，再让 claude_exec 通过 relay 调用。
# claude_exec direct 模式默认会清理 HTTP_PROXY / HTTPS_PROXY。
# 如确实需要保留代理，可在调用工具时传 preserveProxyEnv=true。
# CLAUDE_EXEC_MODE=relay
# CLAUDE_RELAY_URL=http://127.0.0.1:38765
# CLAUDE_RELAY_TOKEN=change-me
